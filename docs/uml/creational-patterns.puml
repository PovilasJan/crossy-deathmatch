@startuml CreationalPatterns
title Crossy Deathmatch server: Singleton, Factory Method, Abstract Factory

' Hand-written; the rendered version is creational-patterns.svg / .png.
' Structures follow refactoring.guru/design-patterns.

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFEF6
  BorderColor #222222
  ArrowColor #222222
}
hide circle

' ---------------- Singleton ----------------
class ServerLog <<leaf>> {
  - {static} _instance : ServerLog [0..1]
  - {static} InstanceLock : object {readOnly}
  - _lock : object {readOnly}
  - ServerLog()
  + {static} GetInstance() : ServerLog
  + Info(text : string) : void
  + Error(ex : Exception) : void
  - Write(text : string) : void
}
ServerLog --> "0..1" ServerLog : -_instance

class Program
interface IGameObserver <<interface>>
class ConsoleObserver {
  + OnState(json : string) : void
  + OnMessage(text : string) : void
}
ConsoleObserver ..|> IGameObserver
ConsoleObserver ..> ServerLog : <<use>>
Program ..> ServerLog : <<use>>

note right of ServerLog
  **Singleton**
  Singleton: ServerLog
  private static field _instance, private constructor,
  static creation method GetInstance() makes the
  instance on the first call (lock + second null check)
  Clients: Program, Game, ConsoleObserver
end note

' ---------------- Abstract Factory ----------------
class Game {
  - _state : GameState
  - UpdateLane(lane : Lane, dt : double, now : long) : void
  - AddLane(now : long) : void
}
Game ..> ServerLog : <<use>>

interface ILaneFactory <<interface>> {
  + {abstract} CreateBuilder() : LaneBuilder
  + {abstract} CreateTraffic() : ILaneTraffic
}
class GrassLaneFactory {
  + CreateBuilder() : LaneBuilder
  + CreateTraffic() : ILaneTraffic
}
class RoadLaneFactory {
  + CreateBuilder() : LaneBuilder
  + CreateTraffic() : ILaneTraffic
}
class RailLaneFactory {
  + CreateBuilder() : LaneBuilder
  + CreateTraffic() : ILaneTraffic
}
GrassLaneFactory ..|> ILaneFactory
RoadLaneFactory ..|> ILaneFactory
RailLaneFactory ..|> ILaneFactory

abstract class LaneBuilder {
  # _lane : Lane
  + Reset(index : int, type : LaneType) : void
  + BuildTrees() : void
  + BuildTraffic(now : long) : void
  + BuildCoins() : void
  + GetLane() : Lane
}
class GrassLaneBuilder
class RoadLaneBuilder
class RailLaneBuilder
GrassLaneBuilder --|> LaneBuilder
RoadLaneBuilder --|> LaneBuilder
RailLaneBuilder --|> LaneBuilder

interface ILaneTraffic <<interface>> {
  + {abstract} Update(lane : Lane, dt : double, now : long) : void
}
class GrassTraffic
class RoadTraffic
class RailTraffic
GrassTraffic ..|> ILaneTraffic
RoadTraffic ..|> ILaneTraffic
RailTraffic ..|> ILaneTraffic

GrassLaneFactory ..> GrassLaneBuilder : <<create>>
GrassLaneFactory ..> GrassTraffic : <<create>>
RoadLaneFactory ..> RoadLaneBuilder : <<create>>
RoadLaneFactory ..> RoadTraffic : <<create>>
RailLaneFactory ..> RailLaneBuilder : <<create>>
RailLaneFactory ..> RailTraffic : <<create>>

Game [type : LaneType] --> "1" ILaneFactory : -LaneFactories
Game [type : LaneType] --> "1" LaneBuilder : -Builders
Game [type : LaneType] --> "1" ILaneTraffic : -Traffic

note top of ILaneFactory
  **Abstract Factory**
  AbstractFactory: ILaneFactory
  ConcreteFactory: GrassLaneFactory, RoadLaneFactory, RailLaneFactory
  AbstractProduct: LaneBuilder, ILaneTraffic
  ConcreteProduct: *LaneBuilder, *Traffic
  Client: Game (gets the factories from LaneFactorySetup)
end note

' ---------------- Factory Method ----------------
class ObstacleFactory <<utility>> {
  + {static} Registry : PrototypeRegistry {readOnly}
  - {static} CreateRegistry() : PrototypeRegistry
  + {static} Create(kind : ObstacleKind, lane : Lane, now : long, x : double [0..1] = null) : Obstacle
  + {static} CreateVehicle(lane : Lane, now : long, x : double [0..1] = null) : Obstacle
}
abstract class ObstacleCreator {
  + {abstract} CreateObstacle() : Obstacle
  + Spawn(lane : Lane, now : long, x : double [0..1] = null) : Obstacle
  # Place(obstacle : Obstacle, lane : Lane, now : long, x : double [0..1]) : void
}
class CarCreator {
  + CreateObstacle() : Obstacle
}
class TruckCreator {
  + CreateObstacle() : Obstacle
}
class TrainCreator {
  + CreateObstacle() : Obstacle
}
class FoxCreator {
  + CreateObstacle() : Obstacle
  # Place(obstacle : Obstacle, lane : Lane, now : long, x : double [0..1]) : void
}
class BoulderCreator {
  + CreateObstacle() : Obstacle
  # Place(obstacle : Obstacle, lane : Lane, now : long, x : double [0..1]) : void
}
CarCreator --|> ObstacleCreator
TruckCreator --|> ObstacleCreator
TrainCreator --|> ObstacleCreator
FoxCreator --|> ObstacleCreator
BoulderCreator --|> ObstacleCreator

class Obstacle {
  + Kind : ObstacleKind
  + X : double
  + Length : int = 1
  + Speed : double
  + LandsAt : long
  + Landed : bool
  + ExpiresAt : long
  + ShallowClone() : Obstacle
  + DeepClone() : Obstacle
}
class PrototypeRegistry {
  + UseDeepCopy : bool = true
  + Create(kind : ObstacleKind) : Obstacle
}
enum ObstacleKind <<enumeration>> {
  Car
  Truck
  Train
  Fox
  Boulder
}
ObstacleCreator ..> Obstacle : <<use>>
ObstacleFactory [kind : ObstacleKind] --> "1" ObstacleCreator : -Creators
ObstacleFactory --> "1" PrototypeRegistry : +Registry

note bottom of ObstacleCreator
  **Factory Method**
  Creator: ObstacleCreator (Spawn calls the factory method CreateObstacle)
  ConcreteCreator: CarCreator, TruckCreator, TrainCreator, FoxCreator, BoulderCreator
  Product: Obstacle (each concrete creator returns a clone of its kind's preset
  from ObstacleFactory.Registry, so there are no concrete product classes)
  Client: ObstacleFactory
end note

@enduml
